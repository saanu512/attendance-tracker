rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /attendanceUsers/{userId} {
      allow create: if request.auth != null && request.auth.uid == userId;
      allow read, update: if request.auth != null && (request.auth.uid == userId || request.auth.token.admin == true);
      allow delete: if request.auth != null && request.auth.token.admin == true;

      match /days/{dateId} {
        allow read, create, update, delete: if request.auth != null && (request.auth.uid == userId || request.auth.token.admin == true);
      }
    }
  }
}
